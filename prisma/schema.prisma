// Kunga Basics — Prisma Schema v4.0
// PostgreSQL on Supabase

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── USERS ───────────────────────────────────────────────────────────────────

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  passwordHash        String?
  googleId            String?   @unique
  name                String
  avatarUrl           String?
  role                UserRole  @default(PARENT)
  subscriptionStatus  SubStatus @default(NONE)
  platform            String?   // "apple_iap" | "google_play" | "stripe" | "flutterwave" | "scholarship"
  pushToken           String?
  lastLoginAt         DateTime?
  // Admin portal preferences
  theme               String    @default("system")  // "system" | "light" | "dark"
  lang                String    @default("en")       // "en" | "fr" | "kin"
  mfaEnabled          Boolean   @default(false)
  passwordChangedAt   DateTime?
  phone               String?
  isActive            Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Relations
  childProfile        ChildProfile?
  preferences         UserPreferences?
  subscription        Subscription?
  progress            UserProgress[]
  routineEntries      RoutineEntry[]
  milestoneReports    MilestoneReport[]
  bookmarks           VideoBookmark[]
  notes               VideoNote[]
  feedback            ModuleFeedback[]
  askGadSubmissions   AskGadSubmission[]
  journalEntries      JournalEntry[]
  announcementDismissals UserAnnouncementDismissal[]
  donations           Donation[]
  scholarshipGrants   ScholarshipGrant[]
  questionCredits     QuestionCredit[]
  visitorSessions     VisitorSession[]
  roleAssignments     UserRoleAssignment[]
  permissionOverrides UserPermission[]
  assignedAskGadSubmissions AskGadSubmission[] @relation("AskGadAssignee")

  @@map("users")
}

enum UserRole {
  PARENT
  ADMIN
}

enum SubStatus {
  NONE
  TRIAL
  ACTIVE
  CANCELLED
  EXPIRED
  SCHOLARSHIP
}

// ─── CHILD PROFILE ───────────────────────────────────────────────────────────

model ChildProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  childName    String
  dateOfBirth  DateTime?
  ageMonths    Int?
  challenges   String[]   // ["speech_delay","attention","autism","hyperactivity","coordination","other"]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("child_profiles")
}

// ─── USER PREFERENCES (notification settings) ────────────────────────────────

model UserPreferences {
  id                   String   @id @default(cuid())
  userId               String   @unique
  notificationsEnabled Boolean  @default(true)
  routineReminderOn    Boolean  @default(true)
  routineReminderTime  String   @default("08:00")   // HH:MM UTC
  streakAlertsOn       Boolean  @default(true)
  milestoneRemindersOn Boolean  @default(true)
  drGadResponseOn      Boolean  @default(true)
  announcementsOn      Boolean  @default(true)
  marketingOn          Boolean  @default(false)
  donationsOn          Boolean  @default(false)
  darkMode             String   @default("system")  // "system"|"light"|"dark"
  textSize             String   @default("medium")  // "small"|"medium"|"large"
  language             String   @default("en")
  cookieConsent        Boolean?
  updatedAt            DateTime @updatedAt

  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

// ─── SUBSCRIPTIONS ───────────────────────────────────────────────────────────

model Subscription {
  id                    String    @id @default(cuid())
  userId                String    @unique
  revenuecatSubscriberId String?
  flutterwaveTxId       String?
  stripePriceId         String?
  plan                  String    // "monthly" | "annual" | "trial"
  status                SubStatus @default(NONE)
  platform              String    // "apple_iap"|"google_play"|"stripe"|"flutterwave"|"scholarship"
  mobileMoneyProvider   String?   // "mpesa"|"mtn_momo"|"airtel_money"|"vodacom_mpesa"
  mobileMoneyPhone      String?
  periodStart           DateTime?
  periodEnd             DateTime?
  cancelledAt           DateTime?
  promoCode             String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  questionAddonUsd      Float     @default(0) // extra monthly cost from question credit add-ons

  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

// ─── QUESTION CREDITS ─────────────────────────────────────────────────────────
// Purchased extra questions for Ask Dr. Gad beyond the monthly limit.
// 1 credit = 1 extra question for the calendar month (monthKey).

model QuestionCredit {
  id          String   @id @default(cuid())
  userId      String
  monthKey    String   // "2026-06" — YYYY-MM; scopes credit to one calendar month
  credits     Int      @default(1)  // extra questions this purchase unlocks
  amountUsd   Float
  status      String   @default("PENDING") // PENDING | ACTIVE | FAILED
  txRef       String?  @unique
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, monthKey])
  @@map("question_credits")
}

// ─── MODULE GROUPS ────────────────────────────────────────────────────────────

model ModuleGroup {
  id                    String   @id @default(cuid())
  name                  String   @unique
  emoji                 String
  description           String?
  sortOrder             Int      @default(0)
  status                ContentStatus @default(PUBLISHED)
  createdAt             DateTime @default(now())
  nameTranslations      Json?    // { "fr": "...", "rw": "...", "sw": "..." }
  descriptionTranslations Json?

  modules               Module[]

  @@map("module_groups")
}

// ─── MODULES ─────────────────────────────────────────────────────────────────

model Module {
  id                      String       @id @default(cuid())
  groupId                 String
  code                    String       @unique  // "C1","T1","L1" etc.
  title                   String
  emoji                   String?      // optional per-module emoji; falls back to group emoji in API
  description             String?
  whatToExpect            String?
  isPreview               Boolean      @default(false)
  status                  ContentStatus @default(DRAFT)
  sortOrder               Int          @default(0)
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
  titleTranslations       Json?        // { "fr": "...", "rw": "...", "sw": "..." }
  descriptionTranslations Json?
  whatToExpectTranslations Json?

  group         ModuleGroup  @relation(fields: [groupId], references: [id])
  videos        Video[]
  resources     ModuleResource[]
  progress      UserProgress[]
  feedback      ModuleFeedback[]

  @@map("modules")
}

// ─── MODULE RESOURCES ─────────────────────────────────────────────────────────

enum ResourceType {
  PDF
  BOOK
  LINK
  AUDIO
  WORKSHEET
  IMAGE
}

model ModuleResource {
  id                      String       @id @default(cuid())
  moduleId                String
  title                   String
  type                    ResourceType
  url                     String
  description             String?
  fileSize                Int?         // bytes (optional, for PDFs/docs)
  pageCount               Int?         // pages (optional, for PDFs/books)
  isPreviewClip           Boolean      @default(false)
  sortOrder               Int          @default(0)
  status                  ContentStatus @default(DRAFT)
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
  titleTranslations       Json?        // { "fr": "...", "rw": "...", "sw": "..." }
  descriptionTranslations Json?

  module      Module       @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@map("module_resources")
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// ─── VIDEOS ──────────────────────────────────────────────────────────────────

model Video {
  id                String       @id @default(cuid())
  moduleId          String
  title             String
  titleTranslations Json?        // { "fr": "...", "rw": "...", "sw": "..." }
  type              VideoType    @default(EXPLANATION)
  cloudflareStreamId String?     @unique
  hlsUrl            String?
  thumbnailUrl      String?
  durationSecs      Int?
  hasdrm            Boolean      @default(true)
  captionsUrl       String?      // SRT/VTT URL
  captionsLang      String?      @default("en")
  isPreviewClip     Boolean      @default(false)
  sortOrder         Int          @default(0)
  status            ContentStatus @default(DRAFT)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  module            Module       @relation(fields: [moduleId], references: [id])
  bookmarks         VideoBookmark[]
  notes             VideoNote[]

  @@map("videos")
}

enum VideoType {
  EXPLANATION
  PRACTICE
  TASTER
  DEMONSTRATION
  ASSESSMENT
}

// ─── USER PROGRESS ────────────────────────────────────────────────────────────

model UserProgress {
  id                String    @id @default(cuid())
  userId            String
  moduleId          String
  watchedPercent    Int       @default(0)
  completed         Boolean   @default(false)
  completedAt       DateTime?
  lastWatchedAt     DateTime?
  lastVideoId       String?
  resumePositionSec Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  module            Module    @relation(fields: [moduleId], references: [id])

  @@unique([userId, moduleId])
  @@map("user_progress")
}

// ─── VIDEO BOOKMARKS & NOTES ─────────────────────────────────────────────────

model VideoBookmark {
  id           String   @id @default(cuid())
  userId       String
  videoId      String
  timestampSec Int
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  video        Video    @relation(fields: [videoId], references: [id])

  @@map("video_bookmarks")
}

model VideoNote {
  id           String   @id @default(cuid())
  userId       String
  videoId      String
  timestampSec Int
  noteText     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  video        Video    @relation(fields: [videoId], references: [id])

  @@map("video_notes")
}

// ─── DAILY ROUTINE ────────────────────────────────────────────────────────────

model RoutineEntry {
  id                 String   @id @default(cuid())
  userId             String
  date               String   // YYYY-MM-DD
  category           String   // "calm"|"attention"|"speech"|"observation"
  taskKey            String
  completed          Boolean  @default(false)
  completedAt        DateTime?
  syncedAt           DateTime?
  createdAt          DateTime @default(now())

  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date, category, taskKey])
  @@map("routine_entries")
}

// ─── MILESTONE REPORTS ───────────────────────────────────────────────────────

model MilestoneReport {
  id              String   @id @default(cuid())
  userId          String
  weekStart       String   // YYYY-MM-DD (Monday)
  responseName    Int?     // 1-5 — optional so partial saves are allowed
  eyeContact      Int?
  sitting         Int?
  sounds          Int?
  calmness        Int?
  notes           String?
  createdAt       DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStart])
  @@map("milestone_reports")
}

// ─── MODULE FEEDBACK ─────────────────────────────────────────────────────────

model ModuleFeedback {
  id              String   @id @default(cuid())
  userId          String
  moduleId        String
  childResponse   Int      // 1-5
  confidence      Int      // 1-5
  comment         String?
  createdAt       DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  module          Module   @relation(fields: [moduleId], references: [id])

  @@unique([userId, moduleId])
  @@map("module_feedback")
}

// ─── ASK DR. GAD ─────────────────────────────────────────────────────────────

model AskGadSubmission {
  id               String          @id @default(cuid())
  userId           String
  questionText     String
  videoR2Key       String?         // Cloudflare R2 object key
  videoDurationSec Int?
  status           SubmissionStatus @default(SUBMITTED)
  responseText     String?
  responseVideoR2Key String?
  respondedAt      DateTime?
  assignedToId     String?
  assignedAt       DateTime?
  escalationReason String?
  escalatedAt      DateTime?
  escalatedById    String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedTo       User?           @relation("AskGadAssignee", fields: [assignedToId], references: [id])

  @@map("ask_gad_submissions")
}

enum SubmissionStatus {
  SUBMITTED
  UNDER_REVIEW
  RESPONDED
  ESCALATED
}

// ─── JOURNAL ─────────────────────────────────────────────────────────────────

model JournalEntry {
  id         String   @id @default(cuid())
  userId     String
  date       String   // YYYY-MM-DD
  title      String?
  mood       String?  // great | good | okay | tough | hard
  tags       String[] @default([])
  noteText   String?
  photoR2Key String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("journal_entries")
}

// ─── ANNOUNCEMENTS ───────────────────────────────────────────────────────────

model Announcement {
  id                String             @id @default(cuid())
  title             String
  body              String
  titleTranslations Json?              // { "fr": "...", "rw": "...", "sw": "..." }
  bodyTranslations  Json?
  deepLink          String?
  targetAudience  AnnTarget          @default(ALL_SUBSCRIBERS)
  status          AnnStatus          @default(DRAFT)
  scheduledAt     DateTime?
  publishedAt     DateTime?
  pushSentCount   Int                @default(0)
  bannerViewCount Int                @default(0)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  dismissals      UserAnnouncementDismissal[]

  @@map("announcements")
}

enum AnnTarget {
  ALL_SUBSCRIBERS
  ACTIVE_ONLY
  SPEECH_MODULE_USERS
  ALL_REGISTERED
}

enum AnnStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  CANCELLED
}

model UserAnnouncementDismissal {
  id             String       @id @default(cuid())
  userId         String
  announcementId String
  dismissedAt    DateTime     @default(now())

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  announcement   Announcement @relation(fields: [announcementId], references: [id])

  @@unique([userId, announcementId])
  @@map("user_announcement_dismissals")
}

// ─── DONATIONS ───────────────────────────────────────────────────────────────

model Donation {
  id                    String         @id @default(cuid())
  userId                String?        // null for guest donations
  email                 String
  amountUsd             Float
  currency              String         @default("USD")
  paymentMethod         DonationMethod
  flutterwaveTxId       String?
  stripePaymentIntentId String?
  campaign              String?        // "Scholarship Fund" | "New Module Development"
  status                DonationStatus @default(PENDING)
  showOnDonorWall       Boolean        @default(false)
  donorName             String?        // for donor wall display
  createdAt             DateTime       @default(now())

  user                  User?          @relation(fields: [userId], references: [id])

  @@map("donations")
}

enum DonationMethod {
  STRIPE
  FLUTTERWAVE
  APPLE_PAY
  GOOGLE_PAY
}

enum DonationStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

// ─── SCHOLARSHIP GRANTS ───────────────────────────────────────────────────────

model ScholarshipGrant {
  id          String   @id @default(cuid())
  grantedBy   String   // admin user id
  userId      String?  // linked after user registers
  email       String
  notes       String?
  active      Boolean  @default(true)
  grantedAt   DateTime @default(now())
  revokedAt   DateTime?

  grantedByUser User?  @relation(fields: [grantedBy], references: [id])

  @@map("scholarship_grants")
}

// ─── ACTIVITY LOG ────────────────────────────────────────────────────────────

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  adminId   String?
  action    String
  details   String?
  meta      Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@map("activity_logs")
}

// ─── RBAC ──────────────────────────────────────────────────────────────────

model Permission {
  id          String   @id @default(cuid())
  code        String   @unique
  description String?
  category    String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]
  userPermissions UserPermission[]

  @@map("permissions")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]
  userAssignments UserRoleAssignment[]

  @@map("roles")
}

model RolePermission {
  roleId       String
  permissionId String

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRoleAssignment {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())

  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model UserPermission {
  userId       String
  permissionId String
  grantedAt    DateTime @default(now())

  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
  @@map("user_permissions")
}

// ─── AUDIT LOG (RBAC actions) ────────────────────────────────────────────────

model AuditLog {
  id            String   @id @default(cuid())
  userId        String?
  action        String
  module        String
  entityType    String?
  entityId      String?
  previousValue Json?
  newValue      Json?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())

  @@map("audit_logs")
}

// ─── WEBSITE / APP ANALYTICS ─────────────────────────────────────────────────

model VisitorSession {
  id             String   @id @default(cuid())
  sessionId      String   @unique
  userId         String?
  source         String   // "portal" | "admin" | "mobile"

  firstSeenAt    DateTime @default(now())
  lastSeenAt     DateTime @default(now())
  pageViews      Int      @default(0)
  isBounce       Boolean  @default(true)

  entryPath      String?
  exitPath       String?
  referrer       String?
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?

  ip             String?
  country        String?
  countryCode    String?
  region         String?
  city           String?
  timezone       String?
  language       String?

  browser        String?
  browserVersion String?
  os             String?
  osVersion      String?
  deviceType     String?  // "desktop" | "mobile" | "tablet"
  screenWidth    Int?
  screenHeight   Int?
  appVersion     String?

  user           User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  events         AnalyticsEvent[]

  @@index([source, firstSeenAt])
  @@index([countryCode])
  @@index([userId])
  @@index([lastSeenAt])
  @@map("visitor_sessions")
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  sessionId String
  userId    String?
  source    String   // "portal" | "admin" | "mobile"
  eventType String   // "pageview" | "click" | "form_submit" | "login" | "logout" | "search" | "upload" | "download" | "video_play" | ...
  path      String?
  label     String?
  meta      Json?
  createdAt DateTime @default(now())

  session   VisitorSession @relation(fields: [sessionId], references: [sessionId], onDelete: Cascade)

  @@index([source, eventType, createdAt])
  @@index([path])
  @@index([sessionId])
  @@map("analytics_events")
}
