# ═══════════════════════════════════════════════════════════
#  kunga-api — Environment Variables
#  Copy this file to .env and fill in your values.
#  In Docker: REDIS_URL is overridden by docker-compose to
#             point to the kunga-redis container automatically.
# ═══════════════════════════════════════════════════════════

# ─── APP ─────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# ─── CORS ────────────────────────────────────────────────
# Comma-separated list of origins allowed to call the API.
# Use CORS_ORIGINS in production to list all allowed domains.
# Falls back to FRONTEND_URL + ADMIN_URL if not set.
#
# Development (single machine):
# FRONTEND_URL=http://localhost:5173
# ADMIN_URL=http://localhost:5174
#
# Production (recommended — list every allowed origin):
# CORS_ORIGINS=https://portal.kunga.devemm.rw,https://app.kungabasics.com
#
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
# CORS_ORIGINS=https://portal.kunga.devemm.rw,https://app.kungabasics.com

# ─── LOGGING ─────────────────────────────────────────────
# Production only: daily rotating log files are written here.
# Ignored in development (logs go to stdout via pino-pretty).
LOG_DIR=/opt/kunga/logs
LOG_RETENTION_DAYS=30

# ─── DATABASE ────────────────────────────────────────────
# Supabase → Settings → Database → Connection String (URI mode)
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres"

# ─── JWT ─────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-at-least-32-chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# ─── GOOGLE OAUTH ────────────────────────────────────────
# https://console.cloud.google.com → Credentials → OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ─── CLOUDFLARE STREAM (video hosting) ──────────────────
# https://dash.cloudflare.com → Stream → API Tokens
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_STREAM_API_TOKEN=your-cloudflare-stream-api-token
CLOUDFLARE_STREAM_SIGNING_KEY=your-stream-signing-key-for-signed-urls

# ─── CLOUDFLARE R2 (file storage) ────────────────────────
# https://dash.cloudflare.com → R2 → Manage R2 API Tokens
CLOUDFLARE_R2_ACCESS_KEY=your-r2-access-key
CLOUDFLARE_R2_SECRET_KEY=your-r2-secret-key
CLOUDFLARE_R2_BUCKET=kunga-basics
CLOUDFLARE_R2_PUBLIC_URL=https://assets.kungabasics.com

# ─── STRIPE ──────────────────────────────────────────────
# https://dashboard.stripe.com → Developers → API Keys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_MONTHLY_PRICE_ID=price_monthly_...
STRIPE_ANNUAL_PRICE_ID=price_annual_...

# ─── FLUTTERWAVE ─────────────────────────────────────────
# https://dashboard.flutterwave.com → Settings → API
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-...
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-...
FLUTTERWAVE_WEBHOOK_HASH=your-flutterwave-webhook-hash
FLUTTERWAVE_REDIRECT_URL=kungabasics://payment

# ─── REVENUECAT (Apple IAP + Google Play) ────────────────
# https://app.revenuecat.com → Project → API Keys
REVENUECAT_API_KEY=appl_...
REVENUECAT_WEBHOOK_AUTH_KEY=your-revenuecat-webhook-auth-key

# ─── EXPO PUSH NOTIFICATIONS ─────────────────────────────
# https://expo.dev → Account Settings → Access Tokens
EXPO_ACCESS_TOKEN=your-expo-access-token

# ─── RESEND (transactional email) ────────────────────────
# https://resend.com → API Keys
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@kungabasics.com

# ─── REDIS (BullMQ job queues) ───────────────────────────
REDIS_URL=redis://localhost:6379

# ─── POSTHOG (analytics) ─────────────────────────────────
# https://app.posthog.com → Project Settings → Project API Key
POSTHOG_API_KEY=phc_...
POSTHOG_HOST=https://app.posthog.com
